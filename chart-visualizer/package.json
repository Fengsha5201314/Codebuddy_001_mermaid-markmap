{
  "name": "fengsha-diagram-workbench",
  "private": true,
  "version": "1.6.0",
  "description": "风沙的本地优先智能流程图与可视化画布工作台",
  "author": "风沙",
  "main": "dist-electron/main.cjs",
  "bin": {
    "fengsha-diagram": "dist-cli/fengsha-diagram.cjs"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm cli:compile",
    "preview": "vite preview",
    "cli:compile": "tsc -p tsconfig.cli.json --noEmit && esbuild cli/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-cli/fengsha-diagram.cjs --external:electron --banner:js=\"#!/usr/bin/env node\"",
    "cli": "pnpm cli:compile && node dist-cli/fengsha-diagram.cjs",
    "desktop:compile": "tsc -p tsconfig.desktop.json --noEmit && esbuild desktop/main.ts desktop/preload.ts desktop/cli-preload.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:electron-updater",
    "desktop:dev": "pnpm build && pnpm desktop:compile && electron dist-electron/main.cjs",
    "desktop:pack": "pnpm build && pnpm desktop:compile && electron-builder --dir",
    "desktop:build": "pnpm build && pnpm desktop:compile && electron-builder --win nsis --publish never",
    "desktop:publish": "pnpm build && pnpm desktop:compile && electron-builder --win nsis --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:user-data": "pnpm build && pnpm desktop:compile && node e2e/desktop-user-data.e2e.mjs",
    "test:e2e:cli": "pnpm build && pnpm desktop:compile && node e2e/cli.e2e.mjs",
    "test:e2e:visual": "pnpm build && pnpm desktop:compile && node e2e/visual-canvas.e2e.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.8.9",
    "jspdf": "4.2.1",
    "lucide-react": "^1.11.0",
    "mermaid": "11.17.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^28.0.0",
    "playwright-core": "1.55.0",
    "png-to-ico": "^3.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "online.fengsha.diagram",
    "productName": "风沙图表工作台",
    "executableName": "FengshaDiagram",
    "artifactName": "Fengsha-Diagram-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-cli/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build/fengsha-diagram.cmd",
        "to": "fengsha-diagram.cmd"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "风沙图表工作台",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Fengsha5201314",
        "repo": "Codebuddy_001_mermaid-markmap",
        "releaseType": "release"
      }
    ]
  }
}
