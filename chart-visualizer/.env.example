# Copy this file to .env.local and fill in one or both server-side API keys.
# Never place API keys in VITE_* variables or frontend code.

# CPA AI (defaults to the same endpoint used by the SAP desktop task tool)
CPA_API_KEY=
CPA_BASE_URL=https://cpa.fengsha.online/v1

# Official DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional OpenAI-compatible custom service. These values can also be managed
# from Settings > AI models without exposing the API key to frontend storage.
CUSTOM_AI_LABEL=Custom API
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# Optional: change where server-side visual settings are stored.
# AI_SETTINGS_FILE=.data/ai-providers.json
